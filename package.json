{
  "name": "pharos-agent-credit-passport",
  "version": "0.1.0",
  "description": "A Pharos Skill, SDK, and MCP server for agent reputation scoring and safety-gated exposure caps.",
  "type": "module",
  "main": "sdk/index.js",
  "exports": {
    ".": "./sdk/index.js"
  },
  "bin": {
    "pharos-passport-mcp": "./mcp/server.js"
  },
  "scripts": {
    "demo": "node demos/run-demo.js",
    "demo:verified": "node demos/run-demo.js demos/verified-agent.json",
    "demo:warning": "node demos/run-demo.js demos/warning-agent.json",
    "demo:rogue": "node demos/run-demo.js demos/rogue-agent.json",
    "demo:video": "node demos/video-demo.js",
    "mcp": "node mcp/server.js",
    "test": "node test/sdk.test.js && node test/mcp-smoke.test.js"
  },
  "keywords": [
    "pharos",
    "agent-center",
    "skill",
    "mcp",
    "reputation",
    "credit-scoring",
    "ai-agents"
  ],
  "author": "Travisxvi",
  "license": "MIT"
}
